# ---------------------------------------------------------------------------
# PhishProbe environment. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Vultr Serverless Inference (OpenAI-compatible) ---
# The ONLY place the LLM key lives. It stays in the `api` container and is
# never passed into a sandbox container.
VULTR_INFERENCE_API_KEY=your-vultr-inference-key-here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Model names — verify against `/v1/models` on kickoff and adjust.
# A text model for analysis/verdict and a vision model for screenshots.
MODEL_TEXT=llama-3.3-70b-instruct
MODEL_VISION=qwen2.5-vl-72b-instruct

# --- Sandbox / orchestration ---
# Name of the dedicated Docker network the throwaway containers run on.
SANDBOX_NETWORK=phishprobe-sandbox-net
# Image tag built from ./sandbox/Dockerfile.
SANDBOX_IMAGE=phishprobe-sandbox:latest
# Hard limits per scan (seconds).
SCAN_TIMEOUT_SECONDS=60
ACTION_TIMEOUT_SECONDS=15
# Container resource limits.
SANDBOX_MEM_LIMIT=1g
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=256

# --- API ---
# Where the FastAPI orchestrator stores scans + screenshots.
DATA_DIR=/data
# Cache TTL for identical URLs (hours). 0 disables the cache.
CACHE_TTL_HOURS=6

# --- Web ---
# Public URL the browser uses to reach the API (through Caddy in prod).
NEXT_PUBLIC_API_BASE=/api

# --- Deployment ---
# Domain Caddy requests a TLS cert for. Use the Vultr VM's public hostname.
PUBLIC_DOMAIN=phishprobe.example.com
